# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Embedding model, runs locally on ONNX (no API key). Use bge-base on your own machine and
# bge-small on small free servers (it fits in 512 MB of memory).
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Chunking (changing these means re-running: python -m app.ingest.build_index)
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Retrieval: "hybrid" (embeddings + keyword search) or "dense" (embeddings only)
RETRIEVAL_MODE=hybrid
TOP_K=6
MIN_RELEVANCE_SCORE=0.35

# Storage paths
RAW_DOCS_DIR=data/raw_docs
PROCESSED_DIR=data/processed
VECTOR_STORE_DIR=vector_store
COLLECTION_NAME=ui_pg_knowledge_base
