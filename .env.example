# Groq API (https://console.groq.com/keys)
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# Embedding model, runs locally on ONNX (no API key). Use bge-base on your own machine and
# bge-small on small free servers (it fits in 512 MB of memory).
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Chunking (changing these means re-running: python -m app.ingest.build_index)
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# Retrieval: "hybrid" (embeddings + keyword search) or "dense" (embeddings only)
RETRIEVAL_MODE=hybrid
TOP_K=6
MIN_RELEVANCE_SCORE=0.35

# Storage paths
RAW_DOCS_DIR=data/raw_docs
PROCESSED_DIR=data/processed

# Database. SQLite is fine on your machine; use a free Neon/Supabase Postgres URL on Render, e.g.
# postgresql+psycopg://user:password@host/dbname?sslmode=require
DATABASE_URL=sqlite:///data/app.db
REQUIRE_DATABASE=false

# Admin console: SECRET_KEY signs login cookies. ADMIN_EMAIL/ADMIN_PASSWORD create the first
# super admin when there are no admins yet.
SECRET_KEY=change-me
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Allow model providers on this computer or a private network (an Ollama server). Default: true on
# your machine, false when REQUIRE_DATABASE=true.
ALLOW_LOCAL_MODEL_HOSTS=true

# Reverse proxies in front of the server. 0 = ignore X-Forwarded-For (your own machine). On Render this
# defaults to 1: the visitor address is the last entry, which Render's proxy added.
TRUSTED_PROXY_HOPS=0
